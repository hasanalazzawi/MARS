.data
# reserve space if you want to auto-place the array; otherwise set $t1 manually
arr: .space 160             # room for up to 40 words (optional)

.text
.globl main

# expects:
#   $t0 = N  (number of Fibonacci elements to write, N >= 1)
#   $t1 = base address of first element in data memory
# writes:
#   memory[$t1 + 4*i] = Fib(i) for i=0..N-1
main:
    # --- OPTIONAL auto-init (uncomment to self-run) ---
    # li   $t0, 5           # N
    # la   $t1, arr         # base address for array

    move $t2, $zero         # Fib(0) = 0
    li   $t3, 1             # Fib(1) = 1

    # store Fib(0)
    sw   $t2, 0($t1)
    addiu $t0, $t0, -1
    beq  $t0, $zero, done   # if N==1, finish
    nop

    # store Fib(1)
    sw   $t3, 4($t1)
    addiu $t1, $t1, 4       # advance to next slot (now points at Fib(1))
    addiu $t0, $t0, -1
    beq  $t0, $zero, done   # if N==2, finish
    nop

fib_loop:
    addu $t4, $t2, $t3      # t4 = next = t2 + t3
    addiu $t1, $t1, 4       # move to next element
    sw   $t4, 4($t1)        # store next (offset 4 because $t1 is at Fib(1/last))
    move $t2, $t3           # shift window
    move $t3, $t4
    addiu $t0, $t0, -1
    bgtz $t0, fib_loop
    nop

done:
    li   $v0, 10
    syscall
